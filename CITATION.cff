    given-names: "Cristian"
repository-code: "https://github.com/crstian19/radcheck-bench-es"
url: "https://github.com/crstian19/radcheck-bench-es"
keywords:
  - radiology
  - spanish
  - benchmark
  - nlp
  - evaluation
  - inconsistency-detection
